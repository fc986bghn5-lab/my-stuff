<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Edit <%= listing.name %> · My Stuff</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="/public/images/favicon.svg" type="image/svg+xml">
</head>

<body>

<header class="site-header">
  <a href="/" class="logo">My Stuff</a>

  <div class="header-actions">
    <a href="/admin" class="header-link">← Dashboard</a>
    <a href="/" class="header-link">View site →</a>
  </div>
</header>

<main class="admin-page narrow">

  <a class="back-link" href="/admin">← Back to dashboard</a>

  <div class="admin-heading">
    <div>
      <p class="eyebrow">Edit listing</p>
      <h1><%= listing.name %></h1>
    </div>
  </div>

  <form
    class="listing-form"
    method="POST"
    action="/admin/listings/<%= listing.id %>/edit"
    enctype="multipart/form-data"
  >

    <label>
      Item name
      <input
        type="text"
        name="name"
        value="<%= listing.name %>"
        required
      >
    </label>

    <label>
      Description
      <textarea
        name="description"
        rows="6"
      ><%= listing.description || "" %></textarea>
    </label>

    <div class="form-grid">

      <label>
        Original price
        <input
          type="number"
          step="0.01"
          min="0"
          name="original_price"
          value="<%= listing.original_price ?? "" %>"
        >
      </label>

      <label>
        Asking price
        <input
          type="number"
          step="0.01"
          min="0"
          name="asking_price"
          value="<%= listing.asking_price ?? "" %>"
        >
      </label>

    </div>

    <div class="form-grid">

      <label>
        Condition
        <select name="condition">
          <% [
            "New",
            "Like New",
            "Excellent",
            "Very Good",
            "Good",
            "Fair",
            "For Parts"
          ].forEach(option => { %>

            <option
              value="<%= option %>"
              <%= listing.condition === option ? "selected" : "" %>
            >
              <%= option %>
            </option>

          <% }) %>
        </select>
      </label>

      <label>
        Category
        <select name="category">

          <% [
            "Furniture",
            "Electronics",
            "Kitchen",
            "Clothing",
            "Books",
            "Outdoor",
            "Other"
          ].forEach(option => { %>

            <option
              value="<%= option %>"
              <%= listing.category === option ? "selected" : "" %>
            >
              <%= option %>
            </option>

          <% }) %>

        </select>
      </label>

    </div>

    <% if (listing.image) { %>

      <div class="current-image">
        <p class="form-label">Current photo</p>

        <img
          class="edit-preview"
          src="/uploads/<%= listing.image %>"
          alt="<%= listing.name %>"
        >
      </div>

    <% } %>

    <label>
      Replace photo
      <input
        type="file"
        name="image"
        accept="image/jpeg,image/png,image/webp,image/gif"
      >
      <small>
        Leave this empty to keep the current photo. Maximum 10 MB.
      </small>
    </label>

    <div class="edit-buttons">

      <button
        class="button button-primary"
        type="submit"
      >
        Save changes
      </button>

      <a
        class="button"
        href="/admin"
      >
        Cancel
      </a>

    </div>

  </form>

</main>

</body>
</html>